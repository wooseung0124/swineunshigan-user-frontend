# =============================================================================
# resttime 프론트엔드 환경 변수
# =============================================================================
# 사용법:
#   1. 이 파일을 복사해 `.env` 로 저장
#   2. 값을 채운 뒤 `npm run dev` 재시작 (Vite는 .env 변경 시 재시작 필요)
#
# 주의:
#   - `VITE_` 로 시작하는 값만 클라이언트(브라우저)에 노출됩니다.
#   - `.env` 는 git에 올리지 마세요. (이미 .gitignore 등록됨)
# =============================================================================


# -----------------------------------------------------------------------------
# 백엔드 API (백엔드 팀에서 서버 주소 전달)
# -----------------------------------------------------------------------------
# OAuth 콜백 페이지가 code를 백엔드로 넘길 때 사용합니다.
# 로컬 예: http://localhost:8080
# 운영 예: https://api.resttime.example.com
VITE_API_BASE_URL=

# 백엔드가 구현해야 하는 엔드포인트 (프론트 기준):
#   POST {VITE_API_BASE_URL}/api/auth/kakao/callback   body: { "code": "..." }
#   POST {VITE_API_BASE_URL}/api/auth/naver/callback   body: { "code": "...", "state": "..." }
#   POST {VITE_API_BASE_URL}/api/auth/google/callback  body: { "code": "..." }  ← 구글 콜백 UI 미구현
# 응답 형식 (공통):
#   { "token": "JWT...", "user": { ... } }


# -----------------------------------------------------------------------------
# 소셜 로그인 — 카카오
# -----------------------------------------------------------------------------
# 카카오 개발자 콘솔 > 내 애플리케이션 > REST API 키
VITE_KAKAO_CLIENT_ID=

# Redirect URI (카카오 콘솔에 동일하게 등록)
# 로컬: http://localhost:5173/auth/kakao/callback
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback


# -----------------------------------------------------------------------------
# 소셜 로그인 — 네이버
# -----------------------------------------------------------------------------
# 네이버 개발자 센터 > Application > Client ID
VITE_NAVER_CLIENT_ID=

# Redirect URI (네이버 콘솔에 동일하게 등록)
# 변수명이 KAKAO와 다릅니다 — 코드 기준 그대로 사용
# 로컬: http://localhost:5173/auth/naver/callback
VITE_REDIRECT_URI=http://localhost:5173/auth/naver/callback


# -----------------------------------------------------------------------------
# 소셜 로그인 — 구글
# -----------------------------------------------------------------------------
# Google Cloud Console > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
VITE_GOOGLE_CLIENT_ID=

# Redirect URI (구글 콘솔에 동일하게 등록)
# 로컬: http://localhost:5173/auth/google/callback
# ※ 프론트에 GoogleCallback 페이지/라우트는 아직 없음 (추가 예정)
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback


# -----------------------------------------------------------------------------
# 카카오맵 (홈 화면 지도)
# -----------------------------------------------------------------------------
# 카카오 개발자 콘솔 > JavaScript 키
# (REST API 키와 별도 — 지도 SDK용)
VITE_KAKAO_MAP_KEY=


# -----------------------------------------------------------------------------
# Firebase (Auth, Firestore, Storage, FCM 등)
# -----------------------------------------------------------------------------
# Firebase Console > 프로젝트 설정 > 일반 > 내 앱 (웹)
# 프로젝트 BaaS는 Firebase 기준으로 사용합니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# FCM(푸시) VAPID 키 — Cloud Messaging > 웹 푸시 인증서
# public/firebase-messaging-sw.js 와 함께 설정 필요
# VITE_FIREBASE_VAPID_KEY=
